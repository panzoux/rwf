{
  "Version": "1.0",
  "Functions": [
    {
      "Name": "Open in Explorer",
      "Command": "explorer \"$P\"",
      "Description": "Open current directory in Windows Explorer"
    },
    {
      "Name": "Open Terminal Here",
      "Command": "wt -d \"$P\"",
      "Description": "Open Windows Terminal in current directory"
    },
    {
      "Name": "Ping localhost",
      "Command": "ping 127.0.0.1",
      "Description": "Ping local loopback"
    },
    {
      "Name": "Show IP config",
      "Command": "ipconfig /all",
      "Description": "Show network IP configuration"
    },
    {
      "Name": "Network Tools",
      "Description": "Network diagnostics submenu",
      "Menu": [
        {
          "Name": "Ping localhost",
          "Action": "Ping localhost"
        },
        {
          "Name": "Show IP config",
          "Action": "Show IP config"
        }
      ]
    },
    {
      "Name": "File Operations",
      "Description": "File operation actions submenu",
      "Menu": "menu_file_operations.json"
    }
  ]
}
